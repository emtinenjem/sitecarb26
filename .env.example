# Required for /api/contact and /api/newsletter to actually send email.
# Get a free key at https://resend.com — set these in Vercel Project Settings
# → Environment Variables (never commit a real key to this file).
RESEND_API_KEY=

# Verified sending address. Until you verify a domain in Resend, you can only
# send FROM their sandbox domain (onboarding@resend.dev) and only TO your own
# Resend account email. Verify photocarb.com in Resend to send from/to anyone.
RESEND_FROM="Photocarb <notifications@photocarb.com>"

# Inbox that receives contact-form and newsletter-signup notifications.
CONTACT_INBOX=contact@photocarb.com

# Optional but recommended: prevents two visitors from booking the same discovery-call
# slot. Without these three set, /api/availability reports every slot as open (old
# behavior) and /api/contact skips reserving anything — the form still works either way.
#
# Setup:
#   1. Google Cloud Console → new (or existing) project → enable the "Google Calendar API".
#   2. IAM & Admin → Service Accounts → create one → Keys → Add key → JSON. Open the
#      downloaded file for the two values below (`client_email` and `private_key`).
#   3. In Google Calendar, create/open the calendar you want bookings to land on → Settings
#      → "Share with specific people" → add the service account's email with
#      "Make changes to events" permission.
#   4. Same Settings page → "Integrate calendar" → copy the Calendar ID.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the full private key as one line with literal \n for newlines, e.g.:
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=
